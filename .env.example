# ==============================================================================
# ToolPadi Environment Configuration Example (Placeholders Only)
# ==============================================================================

# Core Application Settings
NODE_ENV="production"
PORT="3000"
APP_URL="https://your-domain.ng"

# ------------------------------------------------------------------------------
# 1. Primary PostgreSQL Database (Production & Portability)
# Supports: Google Cloud SQL, Linux VPS, Docker Compose, Supabase, Neon, RDS, cPanel
# ------------------------------------------------------------------------------
# Priority 1: Unified connection string
DATABASE_URL="postgresql://toolpadi_user:STRONG_PASSWORD_HERE@localhost:5432/toolpadi?sslmode=prefer"

# Priority 2: Individual variables (used if DATABASE_URL is not set)
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="toolpadi_user"
PGPASSWORD="STRONG_PASSWORD_HERE"
PGDATABASE="toolpadi"
PGSSL="false"
PGMAX_POOL="20"

# ------------------------------------------------------------------------------
# 2. Wholesale Supplier API (InsightXPro)
# Kept strictly server-side. Never exposed to browser or client code.
# ------------------------------------------------------------------------------
INSIGHT_API_KEY="YOUR_INSIGHTXPRO_API_KEY_HERE"

# ------------------------------------------------------------------------------
# 3. Security & Admin Authentication
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY="GENERATE_A_64_CHAR_RANDOM_SECRET_KEY"
SESSION_SECRET="GENERATE_ANOTHER_RANDOM_SECRET"

# ------------------------------------------------------------------------------
# 4. Payment Gateway Adapter (Paystack / Flutterwave)
# 'sandbox_simulator' (default) or 'paystack_live' (once merchant verified)
# ------------------------------------------------------------------------------
PAYMENT_MODE="sandbox_simulator"
PAYMENT_WEBHOOK_SECRET="YOUR_PAYSTACK_SECRET_KEY_OR_WEBHOOK_SIGNATURE_KEY"
PAYSTACK_SECRET_KEY="sk_live_PLACEHOLDER_KEY"

# ------------------------------------------------------------------------------
# 5. Currency & Pricing Policies
# ------------------------------------------------------------------------------
DEFAULT_USD_NGN_RATE="1450"

# ------------------------------------------------------------------------------
# 6. Modular Infrastructure Adapters
# ------------------------------------------------------------------------------
# Email: 'console_log' (dev), 'smtp' (VPS/cPanel), 'resend', or 'sendgrid' (cloud)
EMAIL_PROVIDER="console_log"
SMTP_HOST="mail.your-domain.ng"
SMTP_PORT="587"
SMTP_USER="orders@your-domain.ng"
SMTP_PASS="YOUR_SMTP_PASSWORD"
EMAIL_API_KEY="re_PLACEHOLDER"

# Storage: 'local_disk' (VPS/shared hosting), 's3_compatible' (R2/MinIO/S3), 'memory'
STORAGE_PROVIDER="local_disk"
UPLOAD_DIR="uploads"
S3_BUCKET="toolpadi-assets"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY="YOUR_ACCESS_KEY"
S3_SECRET_KEY="YOUR_SECRET_KEY"

# Scheduler: 'in_process' (VPS daemon / PM2), 'cloud_webhook' (Cloud Run), 'disabled'
SCHEDULER_MODE="in_process"
CRON_SECRET="GENERATE_A_RANDOM_CRON_TRIGGER_SECRET"

# Optional AI Studio platform keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"

